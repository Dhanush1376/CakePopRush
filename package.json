{
  "name": "cakepoprush-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "backend:dev": "npm run dev --prefix backend",
    "dev:all": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "lint": "npm run lint --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm run test:backend",
    "ci:frontend": "npm run ci --prefix frontend",
    "ci:backend": "npm run ci --prefix backend",
    "ci": "npm run ci:frontend && npm run ci:backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
