# Frontend Environment Configuration (Public Vite Variables)
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
VITE_STOREFRONT_URL=http://localhost:5173

# Google Authentication (Public Client ID only - NEVER put client secret here!)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Data source configuration ('mock' uses local seed data for catalog; Auth always uses backend API)
VITE_DATA_SOURCE=mock
VITE_MOCK_MODE=true

# Support WhatsApp Number (Digits only with country code, e.g. 919876543210)
VITE_SUPPORT_WHATSAPP=919876543210

# Razorpay Public Key ID (Safe to expose on frontend; NEVER put key secret here!)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

