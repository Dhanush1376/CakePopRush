# ═══════════════════════════════════════════════════════
# CakePopRush Backend Environment Configuration
# ═══════════════════════════════════════════════════════

# Server & System
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
COOKIE_DOMAIN=

# Database Connection (MongoDB URI, falls back to in-memory if empty in dev)
MONGO_URI=mongodb://localhost:27017/cakepoprush

# Security & Token Signing
JWT_SECRET=super_secret_jwt_key_cakepoprush_production_safe_min_32_chars
OTP_SECRET=your_dedicated_delivery_hmac_secret_min_32_chars
DELIVERY_OTP_EXPIRY_MINUTES=60
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
OTP_EXPIRY_MINUTES=10

# Master Admin Configuration
SUPER_ADMIN_EMAIL=admin@cakepoprush.com
SUPER_ADMIN_BOOTSTRAP_ENABLED=true

# Google OAuth (Server verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMS Gateway Configuration
SMS_PROVIDER=mock
FAST2SMS_API_KEY=

# Transactional Email System (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=CakePopRush <hello@cakepoprush.com>

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary / Media Uploads (if enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

